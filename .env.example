NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AI_CONFIG_ENCRYPTION_KEY=
# Shared secret used by the scheduled retention job; required for it to run.
CRON_SECRET=
CHAT_RETENTION_DAYS=30
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verdeo
SESSION_SECRET=replace-with-at-least-32-characters
SESSION_TTL_HOURS=8
SESSION_COOKIE_SAME_SITE=Lax
# Optional OAuth adapter; both values are required when enabled.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SYSTEM_TIMEZONE=America/Argentina/Buenos_Aires
SYSTEM_CURRENCY=ARS
SYSTEM_LOCALE=es-AR
# Vercel Blob store for avatar uploads (VERDEO_ prefix from the Vercel dashboard connection).
VERDEO_STORE_ID=
VERDEO_READ_WRITE_TOKEN=
# Meta App webhook secrets (shared across every WhatsApp Business account — each account's own
# access token is administrable data, set from Cuentas de WhatsApp, not env). Without these the
# webhook exists but refuses every verification/signature check.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
