{
  "name": "@verdeo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:packages && pnpm verify:workspace-runtime && tsup",
    "build:packages": "pnpm --filter @verdeo/ai --filter @verdeo/audit --filter @verdeo/chat --filter @verdeo/auth --filter @verdeo/config --filter @verdeo/contracts --filter @verdeo/customers --filter @verdeo/geocoding --filter @verdeo/orders --filter @verdeo/rbac --filter @verdeo/routing --filter @verdeo/db --filter @verdeo/observability build",
    "build:vercel": "pnpm build:packages && pnpm verify:workspace-runtime",
    "dev": "tsx --conditions=development watch --env-file=../../.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:workspace-runtime": "node scripts/verify-workspace-runtime.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@vercel/blob": "^2.8.0",
    "@verdeo/ai": "workspace:*",
    "@verdeo/audit": "workspace:*",
    "@verdeo/auth": "workspace:*",
    "@verdeo/chat": "workspace:*",
    "@verdeo/config": "workspace:*",
    "@verdeo/contracts": "workspace:*",
    "@verdeo/customers": "workspace:*",
    "@verdeo/db": "workspace:*",
    "@verdeo/geocoding": "workspace:*",
    "@verdeo/observability": "workspace:*",
    "@verdeo/orders": "workspace:*",
    "@verdeo/routing": "workspace:*",
    "hono": "4.13.2",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "xlsx": "0.18.5",
    "zod": "4.4.3"
  }
}
